# Copia este archivo a .env y rellena tus valores reales.
# .env NO se sube a git (está en .gitignore).

# URL con la que accederás a la app desde el móvil/navegador.
# Se codifica dentro de cada QR, así que tiene que ser la dirección real.
BASE_URL=http://TU_IP_O_DOMINIO:8000

# Cadena aleatoria y secreta para firmar la sesión de Flask.
SECRET_KEY=cambia-esto-por-algo-aleatorio
