# Copia este archivo a .env y rellena tus valores reales.
# .env NO se sube a git (está en .gitignore).

# URL con la que accederás a la app desde el móvil/navegador.
# Se codifica dentro de cada QR, así que tiene que ser la dirección real.
BASE_URL=http://TU_IP_O_DOMINIO:8000

# Cadena aleatoria y secreta para firmar la sesión de Flask.
# Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-aleatorio

# Credenciales de acceso a la app (usuario único).
ADMIN_USERNAME=admin
# Genera el hash con:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu-contraseña'))"
# IMPORTANTE: el hash contiene símbolos $ (formato scrypt:...$salt$hash).
# Docker Compose interpola $ en los archivos .env, así que hay que
# duplicarlos como $$ o Compose los borrará silenciosamente. Ejemplo:
#   scrypt:32768:8:1$abc$def  ->  scrypt:32768:8:1$$abc$$def
# Si lo dejas vacío, la app genera una contraseña temporal en el log en
# cada arranque (solo para pruebas rápidas, cambia cada reinicio).
ADMIN_PASSWORD_HASH=
